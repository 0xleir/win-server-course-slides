<mxfile host="app.diagrams.net" agent="win-server-course" version="24.0.0">
  <diagram id="l31-sample" name="企业网络架构图-标准答案">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="企业网络架构图 · lab.local 域&#xa;(第 31 课 · 任务 1 · 标准答案参考)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="340" y="20" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="绘图人：___________　　日期：___________　　班级：高职信安24-1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="340" y="68" width="480" height="24" as="geometry" />
        </mxCell>

        <!-- ========== 服务器网段框 ========== -->
        <mxCell id="server-zone" value="服务器网段 · 静态 IP · 10.10.10.1–.99" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1F3864;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="520" height="340" as="geometry" />
        </mxCell>

        <!-- DC1 -->
        <mxCell id="dc1" value="&lt;b&gt;DC-01&lt;/b&gt;&lt;br&gt;10.10.10.10&lt;br&gt;(DNS: 127.0.0.1)" style="shape=mscae/general/windows_server;html=1;labelPosition=right;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;outlineConnect=0;fillColor=#1F3864;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="120" y="200" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dc1-roles" value="&lt;b&gt;角色：&lt;/b&gt;&lt;br&gt;• AD DS (域控)&lt;br&gt;• DNS&lt;br&gt;• DHCP (Lab-Scope)&lt;br&gt;• AD CS (Lab-Root-CA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="300" width="190" height="100" as="geometry" />
        </mxCell>

        <!-- SVR2 -->
        <mxCell id="svr2" value="&lt;b&gt;SVR2&lt;/b&gt;&lt;br&gt;10.10.10.20&lt;br&gt;(DNS: 10.10.10.10)" style="shape=mscae/general/windows_server;html=1;labelPosition=right;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;outlineConnect=0;fillColor=#2E75B6;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="svr2-roles" value="&lt;b&gt;角色：&lt;/b&gt;成员服务器&lt;br&gt;• IIS (HTTPS)&lt;br&gt;• 文件服务器&lt;br&gt;   - IT-Share&lt;br&gt;   - Finance-Share" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="385" y="300" width="190" height="100" as="geometry" />
        </mxCell>

        <!-- ========== 客户端网段框 ========== -->
        <mxCell id="client-zone" value="客户端网段 · DHCP · 10.10.10.100–.200 (Lab-Scope)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#2F5F2F;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="640" y="130" width="340" height="340" as="geometry" />
        </mxCell>

        <!-- CLIENT1 -->
        <mxCell id="client1" value="&lt;b&gt;CLIENT1&lt;/b&gt;&lt;br&gt;DHCP 自动获取&lt;br&gt;(DNS: 10.10.10.10)" style="shape=mscae/general/user;html=1;labelPosition=right;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;outlineConnect=0;fillColor=#548235;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="700" y="200" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="client1-roles" value="&lt;b&gt;角色：&lt;/b&gt;域成员&lt;br&gt;• Win10&lt;br&gt;• 测试访问&lt;br&gt;• 用户用一个域账号登录&#xa;  任何客户端" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="300" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- ========== Kali 单独一行 (域外) ========== -->
        <mxCell id="kali-zone" value="授权测试机 · 不加域 · 第 35 课使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#8B2A2A;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="kali" value="&lt;b&gt;Kali&lt;/b&gt;&lt;br&gt;10.10.10.50&lt;br&gt;(不加域)" style="shape=mscae/general/service;html=1;labelPosition=right;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;outlineConnect=0;fillColor=#B85450;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kali-note" value="⚠️ 授权边界：仅限 10.10.10.0/24 范围内，仅第 35 课使用。&lt;br&gt;本课不扫描、不登录，仅做纸面规划审查。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="540" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- ========== 域名横幅 ========== -->
        <mxCell id="domain-banner" value="🌐 Active Directory 域：lab.local" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="640" y="500" width="340" height="40" as="geometry" />
        </mxCell>

        <!-- ========== OU / 用户组 ========== -->
        <mxCell id="ou-box" value="&lt;b&gt;OU=Company 下：&lt;/b&gt;&lt;br&gt;• IT-Dept         👥 Domain-IT&lt;br&gt;• Finance-Dept    👥 Domain-Finance&lt;br&gt;• HR-Dept         👤 HR 员工&lt;br&gt;• Sales-Dept      👥 Domain-Sales&lt;br&gt;• Servers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="640" y="550" width="340" height="100" as="geometry" />
        </mxCell>

        <!-- ========== 访问箭头 ========== -->
        <!-- CLIENT1 -> DC1: LDAP 389 / DNS 53 / Kerberos 88 / DHCP 67 -->
        <mxCell id="edge1" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F3864;strokeWidth=2;startArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client1" target="dc1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge1-label" value="DNS 53 / DHCP 67&#xa;LDAP 389 / Kerberos 88" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#1F3864;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="305" y="195" width="180" height="30" as="geometry" />
        </mxCell>

        <!-- CLIENT1 -> SVR2: HTTPS 443 / SMB 445 -->
        <mxCell id="edge2" style="endArrow=classic;html=1;rounded=0;strokeColor=#2E75B6;strokeWidth=2;startArrow=none;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="client1" target="svr2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge2-label" value="HTTPS 443 / SMB 445" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#2E75B6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="255" width="140" height="20" as="geometry" />
        </mxCell>

        <!-- SVR2 -> DC1: 加域/认证依赖 -->
        <mxCell id="edge3" style="endArrow=classic;html=1;rounded=0;strokeColor=#548235;strokeWidth=1.5;startArrow=none;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="svr2" target="dc1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge3-label" value="成员机 → 域控&#xa;Kerberos / LDAP" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#548235;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="150" width="140" height="30" as="geometry" />
        </mxCell>

        <!-- ========== 攻击面标注 (攻击者视角) ========== -->
        <mxCell id="attack-title" value="🎯 攻击者视角：最值得攻击的点（第 35 课复用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;fontColor=#8B2A2A;" vertex="1" parent="1">
          <mxGeometry x="80" y="670" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="attack-list" value="① SVR2 的 IIS (面向客户端的 Web, 入口最大)&#xa;② DC1 的 AD CS (拿到 CA 私钥=全域信任崩塌)&#xa;③ CLIENT1 的域账号 (作为跳板横向移动, 密码喷射/Kerberoasting)&#xa;④ SMB 445 (Finance-Share 存敏感文件, 弱 ACL 可直接读取)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F0;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=15;fontSize=11;fontColor=#8B2A2A;" vertex="1" parent="1">
          <mxGeometry x="80" y="710" width="900" height="90" as="geometry" />
        </mxCell>

        <!-- 右上角图例 -->
        <mxCell id="legend" value="&lt;b&gt;图例&lt;/b&gt;&#xa;━━ 实线：客户端业务流量&#xa;┅┅ 虚线：成员机对域控的依赖&#xa;🟦 服务器区   🟩 客户端区&#xa;🟥 域外测试区 🟨 域/AD 对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="130" width="170" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
