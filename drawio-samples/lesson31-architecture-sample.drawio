<mxfile host="app.diagrams.net" agent="win-server-course" version="24.0.0">
  <diagram id="l31-final" name="企业网络架构图-标准答案">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0" background="#FAFAFA">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="企业网络架构图 · lab.local 域" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="第 31 课 · 任务 1 标准答案参考　|　绘图人：___________　日期：___________" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="340" y="75" width="620" height="24" as="geometry" />
        </mxCell>

        <!-- ========== 服务器网段框 ========== -->
        <mxCell id="server-zone" value="🏢 服务器网段 · 静态 IP · 10.10.10.1–.99" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1F3864;dashed=1;dashPattern=8 4;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="580" height="420" as="geometry" />
        </mxCell>

        <!-- DC-01 节点 (用大圆角矩形 + emoji 代替图标) -->
        <mxCell id="dc1-box" value="&lt;div style=&quot;font-size:40px;line-height:1;margin-bottom:8px&quot;&gt;🏛️&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;color:#1F3864&quot;&gt;DC-01&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#595959&quot;&gt;10.10.10.10&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#999&quot;&gt;域控制器&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=3;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="175" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dc1-roles" value="&lt;b style=&quot;color:#1F3864;font-size:12px&quot;&gt;角色（4 合 1）&lt;/b&gt;&#10;━━━━━━━━━━━&#10;🗂️  AD DS（域控）&#10;🌐  DNS&#10;📡  DHCP · Lab-Scope&#10;🔐  AD CS · Lab-Root-CA&#10;━━━━━━━━━━━&#10;DNS → 127.0.0.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="180" height="170" as="geometry" />
        </mxCell>

        <!-- SVR2 节点 -->
        <mxCell id="svr2-box" value="&lt;div style=&quot;font-size:40px;line-height:1;margin-bottom:8px&quot;&gt;🗄️&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;color:#2E75B6&quot;&gt;SVR2&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#595959&quot;&gt;10.10.10.20&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#999&quot;&gt;成员服务器&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;strokeWidth=3;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="175" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="svr2-roles" value="&lt;b style=&quot;color:#2E75B6;font-size:12px&quot;&gt;角色：成员服务器&lt;/b&gt;&#10;━━━━━━━━━━━&#10;🌐  IIS（HTTPS）&#10;📁  文件服务器&#10;    · IT-Share&#10;    · Finance-Share&#10;━━━━━━━━━━━&#10;DNS → 10.10.10.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7FC;strokeColor=#2E75B6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="180" height="170" as="geometry" />
        </mxCell>

        <!-- ========== 客户端网段 ========== -->
        <mxCell id="client-zone" value="💻 客户端网段 · DHCP · 10.10.10.100–.200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#2F5F2F;dashed=1;dashPattern=8 4;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="130" width="340" height="420" as="geometry" />
        </mxCell>

        <!-- CLIENT1 节点 -->
        <mxCell id="client1-box" value="&lt;div style=&quot;font-size:40px;line-height:1;margin-bottom:8px&quot;&gt;💻&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;color:#548235&quot;&gt;CLIENT1&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#595959&quot;&gt;DHCP 自动获取&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#999&quot;&gt;域成员工作站&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;strokeWidth=3;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="175" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="client1-roles" value="&lt;b style=&quot;color:#548235;font-size:12px&quot;&gt;角色：域成员&lt;/b&gt;&#10;━━━━━━━━━━━&#10;🪟  Windows 10&#10;👤  一个域账号登录&#10;    任何客户端&#10;🔍  用于测试访问&#10;━━━━━━━━━━━&#10;DNS → 10.10.10.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAEF;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="330" width="200" height="170" as="geometry" />
        </mxCell>

        <!-- ========== Kali 测试区 ========== -->
        <mxCell id="kali-zone" value="⚠️ 授权测试机区 · 不加域 · 第 35 课使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#8B2A2A;dashed=1;dashPattern=4 4;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="580" height="140" as="geometry" />
        </mxCell>
        <mxCell id="kali-box" value="&lt;div style=&quot;font-size:36px;line-height:1;margin-bottom:4px&quot;&gt;🐉&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:bold;color:#B85450&quot;&gt;Kali Linux&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#595959&quot;&gt;10.10.10.50 · 不加域&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=3;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="615" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="kali-note" value="🚫 &lt;b&gt;授权边界&lt;/b&gt;&#10;　• 仅限 10.10.10.0/24 网段&#10;　• 仅第 35 课使用，本课不扫描&#10;　• 攻击测试故意保持在域外&#10;　  被攻陷不威胁域凭据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F0;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="615" width="350" height="90" as="geometry" />
        </mxCell>

        <!-- ========== 域横幅 ========== -->
        <mxCell id="domain-box" value="&lt;div style=&quot;font-size:32px;line-height:1&quot;&gt;☁️&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:bold;color:#7F6000&quot;&gt;Active Directory 域&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:bold;color:#7F6000&quot;&gt;lab.local&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#D6B656;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="580" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ou-box" value="&lt;b style=&quot;color:#7F6000&quot;&gt;OU=Company 下：&lt;/b&gt;&#10;　• IT-Dept　　　　👥 Domain-IT&#10;　• Finance-Dept　　👥 Domain-Finance&#10;　• HR-Dept　　　　👤 HR 员工&#10;　• Sales-Dept　　　👥 Domain-Sales&#10;　• Servers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="680" y="665" width="340" height="100" as="geometry" />
        </mxCell>

        <!-- ========== 访问箭头 ========== -->
        <!-- CLIENT1 -> DC1: 走图下方 -->
        <mxCell id="edge1" style="endArrow=classic;html=1;strokeColor=#1F3864;strokeWidth=2.5;startArrow=none;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="client1-box" target="dc1-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="818" y="330" />
              <mxPoint x="212" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge1-label" value="DNS 53 · DHCP 67 · LDAP 389 · Kerberos 88" style="text;html=1;strokeColor=#1F3864;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#1F3864;fontStyle=1;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="318" width="280" height="26" as="geometry" />
        </mxCell>

        <!-- CLIENT1 -> SVR2: 直线中间 -->
        <mxCell id="edge2" style="endArrow=classic;html=1;strokeColor=#2E75B6;strokeWidth=2.5;startArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client1-box" target="svr2-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge2-label" value="HTTPS 443 · SMB 445" style="text;html=1;strokeColor=#2E75B6;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#2E75B6;fontStyle=1;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="228" width="150" height="24" as="geometry" />
        </mxCell>

        <!-- SVR2 -> DC1: 虚线依赖 -->
        <mxCell id="edge3" style="endArrow=classic;html=1;strokeColor=#548235;strokeWidth=1.5;startArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="svr2-box" target="dc1-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge3-label" value="成员机 ⇄ 域控（Kerberos 认证）" style="text;html=1;strokeColor=#548235;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#548235;fontStyle=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="150" width="190" height="22" as="geometry" />
        </mxCell>

        <!-- ========== 攻击面 ========== -->
        <mxCell id="attack-title" value="🎯 攻击者视角：最值得攻击的点（第 35 课复用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;fontColor=#8B2A2A;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="960" height="36" as="geometry" />
        </mxCell>
        <mxCell id="attack-list" value="&lt;b&gt;①&lt;/b&gt; SVR2 的 IIS 　　（面向客户端的 Web，入口最大）&#10;&lt;b&gt;②&lt;/b&gt; DC1 的 AD CS 　（拿到 CA 私钥 = 全域信任崩塌）&#10;&lt;b&gt;③&lt;/b&gt; CLIENT1 的域账号（作为跳板横向移动，密码喷射 / Kerberoasting）&#10;&lt;b&gt;④&lt;/b&gt; SMB 445 　　　（Finance-Share 存敏感文件，弱 ACL 可直接读取）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F0;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=20;fontSize=11;fontColor=#8B2A2A;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="960" height="100" as="geometry" />
        </mxCell>

        <!-- ========== 右侧 图例 + 规划原则 ========== -->
        <mxCell id="legend-title" value="📋 图例" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="130" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-box" value="&lt;b style=&quot;color:#1F3864&quot;&gt;━━&lt;/b&gt;　客户端 → 域控&#10;&lt;b style=&quot;color:#2E75B6&quot;&gt;━━&lt;/b&gt;　客户端 → 文件/Web&#10;&lt;b style=&quot;color:#548235&quot;&gt;┅┅&lt;/b&gt;　成员机 → 域控&#10;&#10;🟦 服务器区（静态 IP）&#10;🟩 客户端区（DHCP）&#10;🟥 域外测试区&#10;🟨 AD 域对象&#10;&#10;📏 &lt;b&gt;实验限制&lt;/b&gt;：&#10;　单一 Host-Only&#10;　10.10.10.0/24 网段&#10;　网段划分仅规划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="160" width="220" height="280" as="geometry" />
        </mxCell>
        <mxCell id="principle-card" value="&lt;b style=&quot;color:#1F3864&quot;&gt;📐 规划三原则&lt;/b&gt;&#10;━━━━━━━━━━&#10;&lt;b&gt;①&lt;/b&gt; &lt;b&gt;命名&lt;/b&gt;：名字体现用途&#10;&lt;b&gt;②&lt;/b&gt; &lt;b&gt;IP&lt;/b&gt;：服务器静态&#10;　　客户端 DHCP&#10;&lt;b&gt;③&lt;/b&gt; &lt;b&gt;角色分配&lt;/b&gt;：&#10;　DC 只放身份类服务&#10;　业务服务放成员机&#10;　一台挂了不拖垮全部" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="450" width="220" height="190" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
